@startuml
!include style.iuml

interface Game <<interface>> {
  +handleInput(input: String): String
  +isFinished(): boolean
  +reset(): void
}

class GtaGame {
  -storyMap: Map<String, StoryNode>
  -currentNodeKey: String
  -isFinished: boolean
  +handleInput(input: String): String
  +isFinished(): boolean
  +reset(): void
}

class StoryNode {
  -text: String
  -choiceLabels: String[]
  -choiceKeys: String[]
  -isEnding: boolean
  +getChoiceKeys(): String[]
  +isEnding(): boolean
  +formatForDisplay(): String
}

GtaGame ..|> Game
GtaGame *--> "*" StoryNode : stores story graph of <
StoryNode --> "*" StoryNode : leads to >
@enduml
