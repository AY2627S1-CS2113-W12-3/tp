@startuml
!include style.iuml

actor Player
participant ":CommandHandler" as Handler
participant ":CalculatorGame" as Game
participant "currentProblem:ArithmeticProblem" as Problem
participant "<<class>>\nArithmeticProblem" as ProblemClass
participant ":PointsStore" as Points

Player -> Handler : enters an answer
activate Handler

Handler -> Game : handleInput(...)
activate Game

Game -> Game : parseWholeNumber(...)
activate Game
deactivate Game

Game -> Problem : getAnswer()
activate Problem
Problem --> Game : expected answer
deactivate Problem

Game -> ProblemClass : generate(...)
activate ProblemClass
ProblemClass --> Game : next problem
deactivate ProblemClass

Game --> Handler : feedback and next round prompt
deactivate Game

Handler -> Game : getPointsEarnedForLastAction()
activate Game
Game --> Handler : points earned
deactivate Game

Handler -> Points : addPoints(...)
activate Points
Points --> Handler : updated total
deactivate Points

Handler --> Player : display result and points
deactivate Handler
@enduml
