@startuml
!include style.iuml

interface Game <<interface>> {
  +handleInput(input: String): String
  +isFinished(): boolean
  +reset(): void
}

class CalculatorGame {
  -currentProblem: ArithmeticProblem
  -roundNumber: int
  -correctCount: int
  -attemptedCount: int
  +handleInput(input: String): String
  +isFinished(): boolean
  +reset(): void
}

class ArithmeticProblem {
  -leftOperand: int
  -rightOperand: int
  -answer: int
  +{static} generate(random: Random): ArithmeticProblem
  +getAnswer(): int
  +toString(): String
}

enum Operator <<enumeration>> {
  ADD
  SUBTRACT
  MULTIPLY
  DIVIDE
}

CalculatorGame ..|> Game
CalculatorGame *--> "1" ArithmeticProblem : asks <
ArithmeticProblem --> "1" Operator : uses >
@enduml
